{
  "name": "friends-slop-maze",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "tsx src/server/node-server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "artifact": "npm run build && node scripts/build-artifact.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "verify:artifact": "npm run artifact && node scripts/verify-artifact.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^7.54.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  }
}
